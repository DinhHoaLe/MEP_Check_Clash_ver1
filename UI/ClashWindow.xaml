            </WrapPanel>
            <StackPanel Grid.Row="3">
              <TextBlock Text="3D VIEW" Style="{StaticResource Field}"/>
              <Grid x:Name="ViewActions"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <ComboBox x:Name="View3DCombo" DisplayMemberPath="Name" ToolTip="Choose an orthographic Revit 3D view"/>
                <Button Grid.Column="1" Content="View clash" Click="ViewClash_Click" VerticalAlignment="Top" Style="{StaticResource PrimaryButton}" Padding="14,9"/>
              </Grid>
            </StackPanel>
            <Border Grid.Row="4" Background="#F5F2EE" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="10" ClipToBounds="True">
              <Grid>
                <Viewport3D x:Name="ClashViewport" MouseLeftButtonDown="Preview_MouseDown" MouseMove="Preview_MouseMove" MouseLeftButtonUp="Preview_MouseUp" MouseWheel="Preview_MouseWheel"/>
                <TextBlock x:Name="PreviewHint" Text="Select a clash to preview its two elements" Foreground="{StaticResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
                <TextBlock Text="A · brown     B · blue  |  Drag to orbit · scroll to zoom" FontSize="10" Foreground="{StaticResource Muted}" Margin="12" VerticalAlignment="Bottom" IsHitTestVisible="False"/>
              </Grid>
            </Border>
          </Grid>
        </Border>
      </Grid>
      <Border Grid.Row="2" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="20,12">
        <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <StackPanel VerticalAlignment="Center" Margin="0,0,20,0"><TextBlock x:Name="Summary" Text="Select sources and categories, then run the check." TextWrapping="Wrap" Foreground="{StaticResource Muted}" FontSize="12"/><ProgressBar x:Name="Progress" Height="4" Margin="0,8,0,0" Foreground="{StaticResource AccentDark}" Visibility="Collapsed"/></StackPanel>
          <Button x:Name="CancelButton" Grid.Column="1" Content="Cancel check" Click="Cancel_Click" Visibility="Collapsed" Margin="0,0,12,0"/>
          <Button x:Name="RunButton" Grid.Column="2" Content="Run Hard Clash" Style="{StaticResource PrimaryButton}" Click="Run_Click"/>
        </Grid>
      </Border>
    </Grid>
</Window>
